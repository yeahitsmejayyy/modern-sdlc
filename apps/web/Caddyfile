# With DOMAIN set (production), Caddy gets an HTTPS certificate for it automatically.
# Without it (local), it serves plain HTTP on port 80.
{$DOMAIN::80} {
	@api path /api/* /health
	handle @api {
		reverse_proxy server:8000
	}

	# Everything else is the React app. Unknown paths fall back to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Staging runs as a second stack on the same server (compose.staging.yaml). Only this
# Caddy can own ports 80/443, so it fronts the staging domain too and hands every
# request to staging's own web container over the shared "edge" network.
# A 502 here means staging isn't deployed (or is down); production is unaffected.
{$STAGING_DOMAIN} {
	reverse_proxy staging-web:80 {
		# Staging's Caddy has this same block. Rewriting Host means it never matches
		# its own staging site (and forwards to itself); it just serves the app.
		header_up Host {upstream_hostport}
	}
}
