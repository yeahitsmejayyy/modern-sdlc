# Local default. Production uses a real secret (set in GitHub Actions, written to the server's .env).
POSTGRES_PASSWORD=app

# Production domain, e.g. sdlc.example.com. Leave empty locally to serve plain HTTP on port 80.
DOMAIN=

# Image tag to run. CD sets this to the commit SHA.
TAG=latest

# Password for the login screen. Production and staging use their own secrets.
APP_PASSWORD=app

# Bearer token for agents (e.g. Edith). Leave empty to switch agent access off.
API_TOKEN=
